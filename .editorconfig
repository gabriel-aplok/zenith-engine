# Ultimate EditorConfig for Modern C++ Development
root = true

# Global settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Specific overrides for C++ source and header files
[*.{cpp,h,hpp,cc,cxx,hh,inl}]
indent_style = space
indent_size = 4
tab_width = 4
max_line_length = 100

# Microsoft Visual Studio / C++ Extension specific formatting rules
cpp_indent_braces = false
cpp_indent_multi_line_relative_to_line_start = true
cpp_space_before_pointer_asterisk = false
cpp_space_after_pointer_asterisk = true
cpp_space_before_reference_ampersand = false
cpp_space_after_reference_ampersand = true
cpp_space_after_cast = false

# Rules for build systems and configuration files
[{CMakeLists.txt,*.cmake}]
indent_style = space
indent_size = 2

[{Makefile,*.mk}]
indent_style = tab
indent_size = 4

[*.json]
indent_style = space
indent_size = 2
